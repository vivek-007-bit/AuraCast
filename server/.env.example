# Django Application Settings
DJANGO_SECRET_KEY=django-insecure-replace-this-in-production-with-a-secure-random-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app

# Cross-Origin Resource Sharing (CORS)
# Add your local Vite dev server and deployed Netlify frontend URLs (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Weather Providers
# Optional: OpenWeatherMap API key (if blank, AuraCast automatically uses Open-Meteo as high-precision fallback)
OPENWEATHER_API_KEY=

# ML & Performance Constraints
HISTORICAL_DAYS=30
HTTP_TIMEOUT_SECONDS=10.0
ML_N_ESTIMATORS=60
ML_RANDOM_STATE=42
CACHE_TTL_SECONDS=600
